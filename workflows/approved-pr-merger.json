    {
      "id": "6afbf963-8044-4222-a996-a1bfc1f3c310",
      "name": "Merge Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Carries PR State forward and adds countedOk: every counted check (ci.checks) on the head has an ok conclusion.\n// A non-required check that is red (for example a retired job) makes GitHub report 'unstable'; the counted checks are what the pipeline gates on.\nconst s = $('PR State').item.json;\nconst runs = Array.isArray($json.check_runs) ? $json.check_runs : [];\nconst counted = (s.cfg.ci && s.cfg.ci.checks) || [];\nconst okc = new Set((s.cfg.merge && s.cfg.merge.ok_conclusions) || ['success']);\nconst countedOk = counted.length > 0 && counted.every(n => runs.some(c => c.name === n && c.status === 'completed' && okc.has(String(c.conclusion))));\nreturn { json: { ...s, countedOk } };"
      }
    }
  ],
