    {
      "id": "d7e499e6-0bd4-4d57-b386-c1c6775b5aa4",
      "name": "Failing Counted Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Sweep backup for the repair path: one repair item per failing counted check on an open pipeline PR.\nconst out = [];\nconst states = $('Pipeline PR Not Clean').all();\n$input.all().forEach((it, i) => {\n  const s = states[i] ? states[i].json : null; if (!s) return;\n  const cfg = s.cfg; const counted = (cfg.ci && cfg.ci.checks) || [];\n  const okc = new Set(['success', 'skipped', 'neutral']);\n  const prefix = String(cfg.build.branch_prefix || '');\n  const linked = Number(String(s.pr.head.ref).slice(prefix.length)) || 0;\n  for (const c of (it.json.check_runs || [])) {\n    if (!counted.includes(c.name)) continue;\n    if (c.status !== 'completed' || okc.has(String(c.conclusion))) continue;\n    const item = { delivery_id: 'sweep:' + s.head_sha + ':' + c.name, repository_owner: s.owner, repository_name: s.repo, issue_number: linked, pr_number: s.number, stage: 'repair', feedback_id: s.head_sha + ':' + c.name, check_name: c.name, run_url: c.html_url || '', head_sha: s.head_sha, title: c.name, body: '', labels: [], author: '', issue_url: s.pr.html_url };\n    if (linked > 0) out.push({ json: { list: cfg.queues.intake, payload: JSON.stringify(item) } });\n  }\n});\nreturn out;"
      }
    },
