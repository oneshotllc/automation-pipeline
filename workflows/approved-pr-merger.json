      {
        "id": "83f82a2b-4638-4c5f-b7ee-07e985533616",
        "name": "All Checks Green",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1760,
          420
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "leftValue": "={{ (() => { const runs = $('Check Runs').item.json.check_runs || []; const req = Array.isArray($json.contexts) ? $json.contexts : []; const ok = c => c.status === 'completed' && ['success','skipped','neutral'].includes(c.conclusion); if (req.length) { return req.every(name => runs.some(c => c.name === name && ok(c))); } return runs.length > 0 && runs.every(ok); })() }}",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          }
        }
