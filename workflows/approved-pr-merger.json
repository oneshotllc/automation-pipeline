      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = JSON.parse($input.first().json.cfg);\nconst q = s => 'https://api.github.com/search/issues?per_page=50&q=' + encodeURIComponent(s);\nconst out = [{ json: { url: q(`org:${cfg.org} is:pr is:open review:approved`) } }];\nif (cfg.dependabot && cfg.dependabot.auto_merge) out.push({ json: { url: q(`org:${cfg.org} is:pr is:open draft:false author:app/${String(cfg.dependabot.author).replace(/\\[bot\\]$/, '')}`) } });\nreturn out;"
      }
