      {
        "id": "5b69f6b6-2332-42d0-8014-d42d4dfc67b6",
        "name": "Read Samples",
        "type": "n8n-nodes-base.redis",
        "typeVersion": 1,
        "position": [
          220,
          200
        ],
        "parameters": {
          "operation": "get",
          "propertyName": "samples",
          "key": "metrics:queue-depth",
          "keyType": "list",
          "options": {}
        },
        "alwaysOutputData": true,
