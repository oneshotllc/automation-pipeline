{
  "id": "queueDepthReport01",
  "name": "Queue Depth Report",
  "description": "Summarizes the last 24 h of queue-depth samples and posts them to the configured evidence target. Config-driven; no model call.",
  "active": true,
  "nodes": [
    {
      "id": "f2897221-85f2-494a-9c90-f3241f515c98",
      "name": "Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 14 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "5b69f6b6-2332-42d0-8014-d42d4dfc67b6",
      "name": "Read Samples",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        220,
        200
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "samples",
        "key": "={{ $('Config').first().json.keys.metrics_queue_depth }}",
        "keyType": "list",
        "options": {}
      },
      "alwaysOutputData": true,
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "b7bb648d-8d0b-4005-a1f6-b398ef96bcc6",
      "name": "Summarize 24h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst raw = $input.first().json.samples || []; const since = Date.now() - 24 * 3600 * 1000;\nconst rows = raw.map(s => { try { return JSON.parse(s); } catch (e) { return null; } }).filter(r => r && Date.parse(r.t) >= since);\nconst target = cfg.evidence.queue_depth_report;\nconst [owner, repo] = String(target.repo).split('/');\nif (!rows.length) return [{ json: { owner, repo, issue: target.issue, body: 'No queue-depth samples in the last 24 h.' } }];\nconst keys = Object.keys(rows[0]).filter(k => k !== 't');\nconst mx = k => Math.max(...rows.map(r => r[k] || 0)); const mean = k => (rows.reduce((a, r) => a + (r[k] || 0), 0) / rows.length).toFixed(1);\nconst lines = keys.map(k => `${k.padEnd(22)} max ${String(mx(k)).padStart(4)}  mean ${mean(k)}`);\nconst every = rows.filter((r, i) => i % 30 === 0).map(r => r.t.slice(11, 16) + '  ' + keys.map(k => String(r[k] || 0).padStart(4)).join(' ')).join('\\n');\nconst body = `**Queue depth, last 24 h** (${rows.length} samples, ${rows[0].t} .. ${rows[rows.length - 1].t})\\n\\n\\`\\`\\`\\n${lines.join('\\n')}\\n\\nevery 30th sample (utc  ${keys.join('  ')}):\\n${every}\\n\\`\\`\\`\\nSource: the configured metrics list, written every minute by the sampler workflow.`;\nreturn [{ json: { owner, repo, issue: target.issue, body } }];"
      }
    },
    {
      "id": "715bac34-4de9-49a3-8511-bb1cd8c5c085",
      "name": "Post Report",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "issue",
        "operation": "createComment",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.owner }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.repo }}"
        },
        "issueNumber": "={{ $json.issue }}",
        "body": "={{ $json.body }}"
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "webhookId": "d68de5d1-33e6-4ebe-a814-562b67fe3b0a"
    },
    {
      "id": "ad08f074-2529-4a34-b4d4-8da1d9327771",
      "name": "Load Config",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        110,
        200
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "cfg",
        "key": "cfg:pipeline",
        "keyType": "string",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "2f3556bc-2329-4b23-9230-3788a8e42949",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        165,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: JSON.parse($input.first().json.cfg) }];"
      }
    }
  ],
  "connections": {
    "Read Samples": {
      "main": [
        [
          {
            "node": "Summarize 24h",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize 24h": {
      "main": [
        [
          {
            "node": "Post Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Config": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Read Samples",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily": {
      "main": [
        [
          {
            "node": "Load Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "nodeGroups": []
}