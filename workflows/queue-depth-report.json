        }
      },
      {
        "id": "b7bb648d-8d0b-4005-a1f6-b398ef96bcc6",
        "name": "Summarize 24h",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          200
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const raw=$input.first().json.samples||[]; const since=Date.now()-24*3600*1000;\nconst rows=raw.map(s=>{try{return JSON.parse(s)}catch(e){return null}}).filter(r=>r&&Date.parse(r.t)>=since);\nif(!rows.length) return [{json:{body:'No queue-depth samples in the last 24 h.'}}];\nconst mx=k=>Math.max(...rows.map(r=>r[k]||0)); const mean=k=>(rows.reduce((a,r)=>a+(r[k]||0),0)/rows.length).toFixed(1);\nconst every=rows.filter((r,i)=>i%30===0).map(r=>`${r.t.slice(11,16)} ${String(r.intake).padStart(3)} ${String(r.stream).padStart(3)} ${String(r.build).padStart(3)}`).join('\\n');\nconst body=`**stage:** C2 24 h flat-queue evidence · **by:** n8n workflow \\\"Queue Depth Report\\\" · **when:** ${new Date().toISOString()}\\n\\n\\`\\`\\`\\nsamples: ${rows.length} (${rows[0].t} .. ${rows[rows.length-1].t})\\nqueue:intake      max ${mx('intake')}  mean ${mean('intake')}\\nqueue:oneshotllc  max ${mx('stream')}  mean ${mean('stream')}\\nqueue:build       max ${mx('build')}  mean ${mean('build')}\\n\\nevery 30th sample (utc intake stream build):\\n${every}\\n\\`\\`\\`\\nSource: Redis list metrics:queue-depth, written by the n8n \\\"Queue Depth Sampler\\\" every minute.`;\nreturn [{json:{body}}];"
        }
      },
