      {
        "id": "2feab909-ba34-4a5f-ac91-f3d4d792a800",
        "name": "Failed Recent Deliveries",
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.2,
        "position": [
          1540,
          200
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "leftValue": "={{ Number($json.status_code || 0) < 200 || Number($json.status_code || 0) >= 300 }}",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              },
              {
                "leftValue": "={{ $json.redelivery }}",
                "operator": {
                  "type": "boolean",
                  "operation": "false",
                  "singleValue": true
                }
              },
              {
                "leftValue": "={{ Date.parse($json.delivered_at || 0) >= Date.now() - 3600000 }}",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          }
        }
