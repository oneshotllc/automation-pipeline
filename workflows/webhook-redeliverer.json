    {
      "id": "02281b98-a076-4824-87a7-6737bf49de99",
      "name": "Parse Deliveries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1430,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// GitHub delivery ids exceed 2^53. Read the raw response bytes and keep ids as strings before parsing.\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  let text = '';\n  try { const buf = await this.helpers.getBinaryDataBuffer(i, 'data'); text = buf.toString('utf8'); }\n  catch (e) { const it = items[i]; if (it.binary && it.binary.data && it.binary.data.data) text = Buffer.from(it.binary.data.data, 'base64').toString('utf8'); else if (typeof it.json.data === 'string') text = it.json.data; }\n  const fixed = text.replace(/\"id\"\\s*:\\s*(\\d{15,})/g, '\"id\":\"$1\"');\n  let list = [];\n  try { list = JSON.parse(fixed); } catch (e) { list = []; }\n  for (const d of (Array.isArray(list) ? list : [])) out.push({ json: d, pairedItem: { item: i } });\n}\nreturn out;"
      }
    }
