              "leftValue": "={{ (() => { const cfg = $('Config').first().json; const states = (cfg.feedback && cfg.feedback.review_states) || []; const isReview = $json.event === 'pull_request_review' && states.includes($json.review_state) && $json.review_body.trim().length > 0; const isComment = $json.event === 'pull_request_review_comment' && $json.action === 'created'; return $json.pipeline_branch && $json.linked_issue > 0 && $json.reviewer_is_approver && (isReview || isComment); })() }}",
              "operator": {
