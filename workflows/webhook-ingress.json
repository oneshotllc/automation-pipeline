        "jsCode": "// Same shape the poller produces, so the sorter and consumer cannot tell the two ingress paths apart.\nconst e = $json;\nconst item = { delivery_id: e.delivery_id, repository_owner: e.repository_owner, repository_name: e.repository_name, issue_number: e.issue_number, title: e.title, body: e.body, labels: e.labels, author: e.author, issue_url: e.issue_url };\nreturn { json: { item, payload: JSON.stringify(item) } };"
