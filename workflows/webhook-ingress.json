    {
      "id": "a8865c8c-9aec-47b7-9a61-596746f1817d",
      "name": "Normalize GitHub Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// The only node that knows what a GitHub payload looks like. Everything downstream reads this envelope.\nconst cfg = $('Config').first().json;\nconst headers = $json.headers || {};\nconst b = $json.body || {};\nconst event = String(headers['x-github-event'] || '');\nconst repo = b.repository || {};\nconst sender = b.sender || {};\nconst owner = (repo.owner && repo.owner.login) || (repo.full_name || '').split('/')[0] || '';\nconst name = repo.name || (repo.full_name || '').split('/')[1] || '';\nconst actor = sender.login || '';\nconst actorIsBot = sender.type === 'Bot' || /\\[bot\\]$/.test(actor) || (cfg.bots || []).includes(actor);\nconst prefix = String((cfg.build && cfg.build.branch_prefix) || '');\n// check events: derive the PR from the run's head branch\nconst run = b.check_run || b.workflow_run || null;\nif (run) {\n  const headRef = String(run.head_branch || (run.check_suite && run.check_suite.head_branch) || '');\n  const prs = run.pull_requests || [];\n  const prNum = prs.length ? Number(prs[0].number) : 0;\n  const pipelineBranch = prefix && headRef.startsWith(prefix);\n  const checkName = String(run.name || '');\n  const okc = new Set(['success', 'skipped', 'neutral']);\n  const failed = run.status === 'completed' && !!run.conclusion && !okc.has(String(run.conclusion));\n  return { json: { event, action: String(b.action || ''), repository_owner: owner, repository_name: name, issue_number: prNum, issue_state: 'open', issue_url: prNum ? `https://github.com/${owner}/${name}/pull/${prNum}` : '', title: checkName, body: '', labels: [], author: '', actor, actor_is_bot: actorIsBot,\n    review_state: '', review_body: '', review_id: '', reviewer: '', reviewer_is_approver: false, pr_merged: false,\n    head_ref: headRef, pipeline_branch: pipelineBranch, linked_issue: pipelineBranch ? Number(headRef.slice(prefix.length)) || 0 : 0,\n    check_event: true, check_name: checkName, check_failed: failed, head_sha: String(run.head_sha || ''), run_url: String(run.html_url || ''),\n    admitted_event: (cfg.ingress.events || []).includes(event), delivery_id: 'webhook:' + String(headers['x-github-delivery'] || '') } };\n}\nconst item = b.issue || b.pull_request || {};\nconst labels = (item.labels || []).map(l => typeof l === 'string' ? l : (l && l.name) || '').filter(Boolean);\nconst review = b.review || {};\nconst comment = b.comment || {};\nconst reviewer = (review.user && review.user.login) || (comment.user && comment.user.login) || '';\nconst pr = b.pull_request || {};\nconst headRef = (pr.head && pr.head.ref) || '';\nconst pipelineBranch = prefix && headRef.startsWith(prefix);\nconst linkedIssue = pipelineBranch ? Number(headRef.slice(prefix.length)) || 0 : 0;\nreturn { json: {\n  event, action: String(b.action || ''),\n  repository_owner: owner, repository_name: name, issue_number: Number(item.number || 0),\n  title: item.title == null ? '' : String(item.title), body: item.body == null ? '' : String(item.body),\n  labels, author: (item.user && item.user.login) || '', issue_url: item.html_url || '',\n  issue_state: item.state || '', actor, actor_is_bot: actorIsBot,\n  changed_label: (b.label && b.label.name) || '',\n  review_state: String(review.state || '').toLowerCase(), review_body: String(review.body || comment.body || ''), review_id: String(review.id || comment.id || ''), reviewer,\n  reviewer_is_approver: (cfg.approvers || []).includes(reviewer),\n  pr_merged: pr.merged === true, head_ref: headRef, pipeline_branch: pipelineBranch, linked_issue: linkedIssue,\n  check_event: false, check_name: '', check_failed: false, head_sha: (pr.head && pr.head.sha) || '', run_url: '',\n  admitted_event: (cfg.ingress.events || []).includes(event),\n  delivery_id: 'webhook:' + String(headers['x-github-delivery'] || '') } };"
      }
