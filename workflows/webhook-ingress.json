        "jsCode": "// A feedback item targets the ISSUE the PR was built for; the branch is derived from it downstream.\nconst e = $json;\nconst item = { delivery_id: e.delivery_id, repository_owner: e.repository_owner, repository_name: e.repository_name, issue_number: e.linked_issue, pr_number: e.issue_number, stage: 'feedback', feedback_id: e.review_id, title: e.title, body: '', labels: [], author: e.reviewer, issue_url: e.issue_url };\nreturn { json: { item, payload: JSON.stringify(item) } };"
      }
