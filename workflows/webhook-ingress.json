        "jsCode": "// A repair item targets the ISSUE the PR was built for; dedupe key is head SHA + check name.\nconst e = $json;\nconst item = { delivery_id: e.delivery_id, repository_owner: e.repository_owner, repository_name: e.repository_name, issue_number: e.linked_issue, pr_number: e.issue_number, stage: 'repair', feedback_id: e.head_sha + ':' + e.check_name, check_name: e.check_name, run_url: e.run_url, head_sha: e.head_sha, title: e.check_name, body: '', labels: [], author: '', issue_url: e.issue_url };\nreturn { json: { item, payload: JSON.stringify(item) } };"
