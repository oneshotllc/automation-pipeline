    {
      "id": "57333633-7da0-4d39-b7f5-4498eaeec7fc",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// C4 (.github#31): HMAC-SHA256 of the RAW body vs x-hub-signature-256. Fail closed.\nconst crypto = require('crypto');\nconst secret = String($json.secret || '');\nconst hook = $('Triage Intake').item;\nconst headers = hook.json.headers || {};\nconst sent = String(headers['x-hub-signature-256'] || '');\nlet raw = '';\ntry { raw = Buffer.from(hook.binary.data.data, 'base64').toString('utf8'); }\ncatch (e) { raw = typeof hook.json.body === 'string' ? hook.json.body : JSON.stringify(hook.json.body || {}); }\nlet ok = false, why = '';\nif (!secret) why = 'cfg:gh_webhook_secret is not set';\nelse if (!sent.startsWith('sha256=')) why = 'missing or malformed x-hub-signature-256';\nelse {\n  const mine = 'sha256=' + crypto.createHmac('sha256', secret).update(raw, 'utf8').digest('hex');\n  const a = Buffer.from(mine), b = Buffer.from(sent);\n  ok = a.length === b.length && crypto.timingSafeEqual(a, b);\n  if (!ok) why = 'signature mismatch';\n}\nlet body = hook.json.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nif (!body || typeof body !== 'object') { try { body = JSON.parse(raw); } catch (e) { body = {}; } }\nreturn { json: { __sig_ok: ok, __sig_why: why, headers, body } };"
      }
    },
