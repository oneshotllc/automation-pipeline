    {
      "id": "43019500-e5a5-41bb-9b08-9ea8f74ed996",
      "name": "Pipeline Run Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// A run of the configured build workflow in the dispatch repository gets its run fields and its target parsed from the run name (`<mode> <repo>#<issue>`); everything else passes through untouched.\nconst cfg = $('Config').first().json; const b = $('Triage Intake').item.json.body || {}; const e = $json;\nconst wr = b.workflow_run; const repoFull = `${e.repository_owner}/${e.repository_name}`; const bd = cfg.build || {}; const pr = cfg.pipeline_repair || {};\nconst isPipelineRun = !!wr && e.event === 'workflow_run' && repoFull === bd.dispatch_repo && String(wr.path || '').endsWith('/' + bd.workflow_file);\nif (!isPipelineRun) return { json: e };\nconst title = String(wr.display_title || wr.name || '');\nconst m = title.match(/^(\\S+)\\s+([^\\s#]+)#(\\d+)/);\nconst failed = wr.status === 'completed' && wr.conclusion === 'failure';\nreturn { json: Object.assign({}, e, { pipeline_run: true, pipeline_run_failed: failed && pr.enabled !== false, run_id: String(wr.id), run_url: String(wr.html_url || ''), run_title: title, target_mode: m ? m[1] : '', target_repo: m ? m[2] : '', target_issue: m ? Number(m[3]) : 0, issue_number: m ? Number(m[3]) : 0, head_sha: String(wr.head_sha || '') }) };"
      }
