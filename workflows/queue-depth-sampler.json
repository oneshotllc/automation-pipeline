        "typeVersion": 1,
        "position": [
          220,
          300
        ],
        "parameters": {
          "operation": "get",
          "propertyName": "stream",
          "key": "queue:oneshotllc",
          "keyType": "list",
          "options": {}
        },
        "alwaysOutputData": true,
        "credentials": {
          "redis": {
            "id": "redisLocalQueue1",
            "name": "Redis (local triage queue)"
          }
        }
      },
      {
        "id": "58022c93-558d-4a52-84ae-d83b68bc0667",
        "name": "Build",
        "type": "n8n-nodes-base.redis",
        "typeVersion": 1,
        "position": [
          220,
          500
        ],
        "parameters": {
          "operation": "get",
          "propertyName": "build",
          "key": "queue:build:oneshotllc",
          "keyType": "list",
          "options": {}
        },
        "alwaysOutputData": true,
        "credentials": {
          "redis": {
            "id": "redisLocalQueue1",
            "name": "Redis (local triage queue)"
          }
        }
      },
      {
        "id": "5b809746-5a83-49f6-853b-c3e7bb68cdbe",
        "name": "Merge Counts",
        "type": "n8n-nodes-base.merge",
        "typeVersion": 3.2,
        "position": [
          460,
          300
        ],
        "parameters": {
          "mode": "combine",
          "combineBy": "combineByPosition",
          "numberInputs": 3
        }
      },
      {
        "id": "ad5f1e64-9aa7-4371-be99-91e8c014613e",
        "name": "Sample",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          680,
          300
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const j=$input.first().json; const len=v=>Array.isArray(v)?v.length:(v?1:0);\nreturn [{json:{line: JSON.stringify({t:new Date().toISOString(), intake:len(j.intake), stream:len(j.stream), build:len(j.build)})}}];"
        }
      },
      {
        "id": "e0f4cd45-26a4-4e16-b885-372ff6e61e5e",
        "name": "Append Sample",
        "type": "n8n-nodes-base.redis",
        "typeVersion": 1,
        "position": [
          900,
          300
        ],
        "parameters": {
          "operation": "push",
          "list": "metrics:queue-depth",
          "messageData": "={{ $json.line }}",
          "tail": true
        },
        "credentials": {
          "redis": {
            "id": "redisLocalQueue1",
            "name": "Redis (local triage queue)"
          }
        }
      },
      {
        "id": "2aa4180c-ba39-4965-a236-49ac1710965e",
        "name": "Notes",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -60
        ],
        "parameters": {
          "color": 4,
          "width": 1100,
          "height": 200,
          "content": "## Queue depth sampler (C5.5, .github#40)\n\nOne sample per minute appended to Redis list `metrics:queue-depth` as JSON `{t,intake,stream,build}`. The report workflow reads it. Nothing outside n8n schedules this. (List length is read with the Redis node's list GET; queues are small by design.)"
        }
      }
    ],
