    "id": "queueDepthSampler1",
    "name": "Queue Depth Sampler",
    "description": "C5.5 (#40): every minute record intake/stream/build queue lengths into Redis list metrics:queue-depth (7 days kept). Replaces the launchd sampler.",
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "id": "28eb7ae9-74d6-40cd-a9cd-1c7a641b6ba3",
        "name": "Every Minute",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          200
        ],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 1
              }
            ]
          }
        }
      },
      {
        "id": "3b682dc2-2bd6-4559-8790-403f3f161ddf",
        "name": "Intake",
        "type": "n8n-nodes-base.redis",
        "typeVersion": 1,
        "position": [
          220,
          100
        ],
        "parameters": {
          "operation": "get",
          "propertyName": "intake",
          "key": "queue:intake",
          "keyType": "list",
          "options": {}
        },
