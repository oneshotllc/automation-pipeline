{
  "id": "queueDepthSampler1",
  "name": "Queue Depth Sampler",
  "description": "Records queue depths for every configured queue into the configured metrics list on a schedule. Config-driven; no model call.",
  "active": true,
  "nodes": [
    {
      "id": "28eb7ae9-74d6-40cd-a9cd-1c7a641b6ba3",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ad5f1e64-9aa7-4371-be99-91e8c014613e",
      "name": "Sample",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const names = $('Queues To Sample').all();\nconst counts = {};\n$input.all().forEach((it, i) => { const v = it.json.items; counts[names[i].json.name] = Array.isArray(v) ? v.length : (v ? 1 : 0); });\nreturn [{ json: { metrics_key: names[0].json.metrics_key, line: JSON.stringify(Object.assign({ t: new Date().toISOString() }, counts)) } }];"
      }
    },
    {
      "id": "e0f4cd45-26a4-4e16-b885-372ff6e61e5e",
      "name": "Append Sample",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "operation": "push",
        "list": "={{ $json.metrics_key }}",
        "messageData": "={{ $json.line }}",
        "tail": true
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "2aa4180c-ba39-4965-a236-49ac1710965e",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -60
      ],
      "parameters": {
        "color": 4,
        "width": 1100,
        "height": 200,
        "content": "## Queue Depth Sampler\n\nMechanics only; queue and key names come from the config key. Each tick: one sample with the length of the intake queue and of every configured stream's queue and build queue, appended as a JSON line to the configured metrics list. The report workflow reads it."
      }
    },
    {
      "id": "5ed8cb5c-eb4f-4c53-8aab-d732ddaf8f91",
      "name": "Load Config",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        200,
        200
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "cfg",
        "key": "cfg:pipeline",
        "keyType": "string",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "3416715a-05df-4433-8e28-aaad8d6836bc",
      "name": "Queues To Sample",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = JSON.parse($input.first().json.cfg);\nconst streams = [...new Set([cfg.streams.default, ...((cfg.streams.rules || []).map(r => r.stream))].filter(Boolean))];\nconst lists = [{ name: 'intake', list: cfg.queues.intake }];\nfor (const s of streams) { lists.push({ name: 'stream:' + s, list: cfg.queues.stream_prefix + s }); lists.push({ name: 'build:' + s, list: cfg.queues.build_prefix + s }); }\nreturn lists.map(l => ({ json: { ...l, metrics_key: cfg.keys.metrics_queue_depth } }));"
      }
    },
    {
      "id": "9695797f-4ca9-49b4-b927-283888dd1407",
      "name": "Read Queue",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        600,
        200
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "items",
        "key": "={{ $json.list }}",
        "keyType": "automatic",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      },
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Sample": {
      "main": [
        [
          {
            "node": "Append Sample",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Minute": {
      "main": [
        [
          {
            "node": "Load Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Config": {
      "main": [
        [
          {
            "node": "Queues To Sample",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Queues To Sample": {
      "main": [
        [
          {
            "node": "Read Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Queue": {
      "main": [
        [
          {
            "node": "Sample",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "nodeGroups": []
}