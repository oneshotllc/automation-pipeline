        "parameters": {
          "jsCode": "const src = $json.body ?? $json;\nconst owner = src.repository_owner ?? \"\";\nconst repo = src.repository_name ?? \"\";\nconst number = Number(src.issue_number ?? 0);\nconst item = {\n  delivery_id: src.delivery_id ?? (\"reconcile:\" + owner + \"/\" + repo + \"#\" + number),\n  repository_owner: owner,\n  repository_name: repo,\n  issue_number: number,\n  title: src.title ?? \"\",\n  body: src.body ?? \"\",\n  labels: src.labels ?? [],\n  author: src.author ?? \"\",\n  issue_url: src.issue_url ?? \"\"\n};\nreturn { json: { item, payload: JSON.stringify(item) } };",
          "mode": "runOnceForEachItem"
        }
      },
