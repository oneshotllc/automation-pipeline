  "nodes": [
    {
      "parameters": {
        "content": "One durable local event-backed queue owns build, verify, QA/review, merge, code repair, and infrastructure retry state. Signed webhook events are handed off only after the local service confirms durable semantic acceptance. The local due-time scheduler is the only scheduler; durable queue timestamps survive restart and wake retry or reconciliation work without a parallel n8n watchdog. Zero-step Actions startup failures enter bounded VERIFY_BACKOFF without coder dispatch or repair-attempt consumption."
      },
      "id": "65f26934-19f0-448b-92cf-91f7557bda52",
      "name": "Lifecycle Policy",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -128,
        448
      ]
    },
