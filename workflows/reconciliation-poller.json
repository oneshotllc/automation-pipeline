{
  "id": "kQmdg9QLRiQq2CFz",
  "name": "Reconciliation Poller",
  "description": "Backstop ingress: on a schedule, list every open issue and pull request in the configured org, normalize each into the intake item shape and push to the configured intake queue. Dedup happens downstream. Config-driven; no model call.",
  "active": true,
  "nodes": [
    {
      "id": "91f9a27c-6a01-4d44-927f-e1fa6bc90d23",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        96
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "6ae6ef36-2eb4-459a-a8e6-6fd411091e5e",
      "name": "List Org Repositories",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        224,
        96
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "organization",
        "operation": "getRepositories",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.org }}"
        },
        "returnAll": true
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "webhookId": "e90b12e6-0737-487e-8abc-db7d39cd4c39"
    },
    {
      "id": "3c03e03a-5c53-49a0-ab2c-2183bc6d7d63",
      "name": "List Open Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "repository",
        "operation": "getIssues",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.org }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.name }}"
        },
        "returnAll": true,
        "getRepositoryIssuesFilters": {
          "state": "open"
        }
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "onError": "stopWorkflow",
      "webhookId": "de7f4dab-cc99-4046-ad4f-c153f754d3d0"
    },
    {
      "id": "96533a72-62cf-4317-8deb-351aa30963f4",
      "name": "Combine Open Items",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "33ec7158-91b2-45f1-ae9e-eb2c52febb95",
      "name": "List Open Pull Requests",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        448,
        192
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "repository",
        "operation": "getPullRequests",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.org }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.name }}"
        },
        "returnAll": true,
        "getRepositoryPullRequestsFilters": {
          "state": "open"
        }
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "onError": "stopWorkflow",
      "webhookId": "101b70d1-ce2f-489e-b8ae-baa67a45894d"
    },
    {
      "id": "d1d60f46-c597-46c2-bfbc-b644d1010b1a",
      "name": "Build Normalized Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Backup fetch: re-inject the full open set every cycle.\n// No dedup/claim here - the triage workflow's atomic item-key claim dedupes.\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const g = item.json || {};\n  const url = g.html_url || '';\n  const m = String(url).match(/^https?:\\/\\/[^\\/]+\\/([^\\/]+)\\/([^\\/]+)\\/(?:issues|pull)\\/(\\d+)/);\n  if (!m) { continue; }\n  const owner = m[1];\n  const repo = m[2];\n  const number = parseInt(m[3], 10);\n  const key = owner + '/' + repo + '#' + number;\n  if (seen.has(key)) { continue; }\n  seen.add(key);\n  const rawLabels = Array.isArray(g.labels) ? g.labels : [];\n  const labels = rawLabels.map(function (l) { return typeof l === 'string' ? l : (l && l.name) || ''; }).filter(function (l) { return l !== ''; });\n  out.push({ json: {\n    delivery_id: 'reconcile:' + key,\n    repository_owner: owner,\n    repository_name: repo,\n    issue_number: number,\n    title: g.title == null ? '' : String(g.title),\n    body: g.body == null ? '' : String(g.body),\n    labels: labels,\n    author: (g.user && g.user.login) || '',\n    issue_url: url\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "8edcd765-8c4d-4ee8-8c76-eb0f7e52302b",
      "name": "Enqueue To Redis Queue",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "list": "={{ $('Config').first().json.queues.intake }}",
        "messageData": "={{ JSON.stringify($json) }}",
        "operation": "push",
        "tail": false
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "46aa98e0-934a-4175-adec-93f19f14b201",
      "name": "Load Config",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        110,
        96
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "cfg",
        "key": "cfg:pipeline",
        "keyType": "string",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "619acc11-2394-4030-b23b-13a3131e6062",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        170,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: JSON.parse($input.first().json.cfg) }];"
      }
    }
  ],
  "connections": {
    "List Org Repositories": {
      "main": [
        [
          {
            "node": "List Open Issues",
            "type": "main",
            "index": 0
          },
          {
            "node": "List Open Pull Requests",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Open Issues": {
      "main": [
        [
          {
            "node": "Combine Open Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine Open Items": {
      "main": [
        [
          {
            "node": "Build Normalized Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Open Pull Requests": {
      "main": [
        [
          {
            "node": "Combine Open Items",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Build Normalized Events": {
      "main": [
        [
          {
            "node": "Enqueue To Redis Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Load Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Config": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "List Org Repositories",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "nodeGroups": []
