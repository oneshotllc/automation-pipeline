{
  "id": "kQmdg9QLRiQq2CFz",
  "name": "Reconciliation Poller",
  "description": "Backstop ingress: on a schedule, list every open issue and pull request in the configured org, normalize each into the intake item shape and push to the configured intake queue. Dedup happens downstream. Config-driven; no model call.",
  "active": true,
  "nodes": [
    {
      "id": "91f9a27c-6a01-4d44-927f-e1fa6bc90d23",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        96
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "6ae6ef36-2eb4-459a-a8e6-6fd411091e5e",
      "name": "List Org Repositories",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        224,
        96
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "organization",
        "operation": "getRepositories",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.org }}"
        },
        "returnAll": true
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "webhookId": "e90b12e6-0737-487e-8abc-db7d39cd4c39"
    },
    {
      "id": "3c03e03a-5c53-49a0-ab2c-2183bc6d7d63",
      "name": "List Open Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "repository",
        "operation": "getIssues",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.org }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.name }}"
        },
        "returnAll": true,
        "getRepositoryIssuesFilters": {
          "state": "open"
        }
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "onError": "stopWorkflow",
      "webhookId": "de7f4dab-cc99-4046-ad4f-c153f754d3d0"
    },
    {
      "id": "d1d60f46-c597-46c2-bfbc-b644d1010b1a",
      "name": "Build Normalized Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Backup fetch: re-inject every open issue ticket each cycle. Pull requests are not intake.\n// No dedup/claim here - the sorter's atomic claims dedupe.\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const g = item.json || {};\n  if (g.pull_request) { continue; }\n  const url = g.html_url || '';\n  const m = String(url).match(/^https?:\\/\\/[^\\/]+\\/([^\\/]+)\\/([^\\/]+)\\/issues\\/(\\d+)$/);\n  if (!m) { continue; }\n  const owner = m[1];\n  const repo = m[2];\n  const number = parseInt(m[3], 10);\n  const key = owner + '/' + repo + '#' + number;\n  if (seen.has(key)) { continue; }\n  seen.add(key);\n  const rawLabels = Array.isArray(g.labels) ? g.labels : [];\n  const labels = rawLabels.map(function (l) { return typeof l === 'string' ? l : (l && l.name) || ''; }).filter(function (l) { return l !== ''; });\n  out.push({ json: {\n    delivery_id: 'reconcile:' + key,\n    repository_owner: owner,\n    repository_name: repo,\n    issue_number: number,\n    title: g.title == null ? '' : String(g.title),\n    body: g.body == null ? '' : String(g.body),\n    labels: labels,\n    author: (g.user && g.user.login) || '',\n    issue_url: url\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "8edcd765-8c4d-4ee8-8c76-eb0f7e52302b",
      "name": "Enqueue To Redis Queue",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "list": "={{ $('Config').first().json.queues.intake }}",
        "messageData": "={{ JSON.stringify($json) }}",
        "operation": "push",
        "tail": false
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "46aa98e0-934a-4175-adec-93f19f14b201",
      "name": "Load Config",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        110,
        96
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "cfg",
        "key": "cfg:pipeline",
        "keyType": "string",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "619acc11-2394-4030-b23b-13a3131e6062",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        170,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: JSON.parse($input.first().json.cfg) }];"
      }
    },
    {
      "id": "99d963e8-dad7-48cc-9819-47dc4d4611bf",
      "name": "List Failed Build Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        420
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.build.dispatch_repo }}/actions/workflows/{{ $json.build.workflow_file }}/runs?status=failure&per_page=30&created=>%3D{{ new Date(Date.now() - Number(($json.pipeline_repair || {}).window_minutes || 180) * 60000).toISOString().slice(0,19) }}Z",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      }
    },
    {
      "id": "31588b76-105f-4428-91f4-71f3245ffd76",
      "name": "Failed Runs To Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One pipeline-repair item per failed build run in the window; a run that was itself a repair is skipped (no recursion). The sorter's claim per run id dedupes against the webhook path.\nconst cfg = $('Config').first().json; const pr = cfg.pipeline_repair || {}; const bd = cfg.build || {};\nif (pr.enabled === false) return [];\nconst [owner, name] = String(bd.dispatch_repo || '/').split('/');\nconst out = [];\nfor (const it of $input.all()) {\n  for (const wr of ((it.json && it.json.workflow_runs) || [])) {\n    if (wr.conclusion !== 'failure') continue;\n    const title = String(wr.display_title || wr.name || '');\n    if (title.startsWith('pipeline-repair')) continue;\n    const m = title.match(/^(\\S+)\\s+([^\\s#]+)#(\\d+)/);\n    const item = { delivery_id: 'sweep:run:' + wr.id, repository_owner: owner, repository_name: name, issue_number: m ? Number(m[3]) : 0, stage: 'pipeline-repair', run_id: String(wr.id), run_url: String(wr.html_url || ''), run_title: title, target_repo: m ? m[2] : '', target_issue: m ? Number(m[3]) : 0, target_mode: m ? m[1] : '', head_sha: String(wr.head_sha || ''), title, body: '', labels: [], author: '', issue_url: String(wr.html_url || '') };\n    out.push({ json: { list: cfg.queues.intake, payload: JSON.stringify(item) } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "aed7819e-fb67-47d0-83c9-7116473ca8bc",
      "name": "Enqueue Pipeline Repair",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "operation": "push",
        "list": "={{ $json.list }}",
        "messageData": "={{ $json.payload }}",
        "tail": false
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "d04ce9a3-15c5-4eef-8705-be6e33092b79",
      "name": "Run Sorter",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "EuMYAIadQbkYh0FH"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": false
        },
        "workflowInputs": {
          "mappingMode": "passThrough"
        }
      }
    },
    {
      "id": "1cf974fe-5a9f-47db-b35e-c01f2036f3cc",
      "name": "Run Sorter After Repairs",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "EuMYAIadQbkYh0FH"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": false
        },
        "workflowInputs": {
          "mappingMode": "passThrough"
        }
      }
    }
  ],
