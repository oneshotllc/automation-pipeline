    {
      "id": "d1d60f46-c597-46c2-bfbc-b644d1010b1a",
      "name": "Build Normalized Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Backup fetch: re-inject the full open set every cycle.\n// No dedup/claim here - the triage workflow's atomic item-key claim dedupes.\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const g = item.json || {};\n  const url = g.html_url || '';\n  const m = String(url).match(/^https?:\\/\\/[^\\/]+\\/([^\\/]+)\\/([^\\/]+)\\/(?:issues|pull)\\/(\\d+)/);\n  if (!m) { continue; }\n  const owner = m[1];\n  const repo = m[2];\n  const number = parseInt(m[3], 10);\n  const key = owner + '/' + repo + '#' + number;\n  if (seen.has(key)) { continue; }\n  seen.add(key);\n  const rawLabels = Array.isArray(g.labels) ? g.labels : [];\n  const labels = rawLabels.map(function (l) { return typeof l === 'string' ? l : (l && l.name) || ''; }).filter(function (l) { return l !== ''; });\n  out.push({ json: {\n    delivery_id: 'reconcile:' + key,\n    repository_owner: owner,\n    repository_name: repo,\n    issue_number: number,\n    title: g.title == null ? '' : String(g.title),\n    body: g.body == null ? '' : String(g.body),\n    labels: labels,\n    author: (g.user && g.user.login) || '',\n    issue_url: url\n  } });\n}\nreturn out;"
      }
    },
