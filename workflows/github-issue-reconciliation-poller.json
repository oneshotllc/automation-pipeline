      "onError": "continueRegularOutput",
      "webhookId": "de7f4dab-cc99-4046-ad4f-c153f754d3d0",
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      }
    },
    {
      "id": "96533a72-62cf-4317-8deb-351aa30963f4",
      "name": "Combine Open Items",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "33ec7158-91b2-45f1-ae9e-eb2c52febb95",
      "name": "List Open Pull Requests",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        448,
        192
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "repository",
        "operation": "getPullRequests",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "oneshotllc"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.name }}"
        },
        "returnAll": true,
        "getRepositoryPullRequestsFilters": {
          "state": "open"
        }
      },
      "onError": "continueRegularOutput",
      "webhookId": "101b70d1-ce2f-489e-b8ae-baa67a45894d",
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      }
    },
    {
      "id": "d1d60f46-c597-46c2-bfbc-b644d1010b1a",
      "name": "Build Normalized Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Backup fetch: re-inject the full open set every cycle.\n// No dedup/claim here - the triage workflow's atomic item-key claim dedupes.\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const g = item.json || {};\n  const url = g.html_url || '';\n  const m = String(url).match(/^https?:\\/\\/[^\\/]+\\/([^\\/]+)\\/([^\\/]+)\\/(?:issues|pull)\\/(\\d+)/);\n  if (!m) { continue; }\n  const owner = m[1];\n  const repo = m[2];\n  const number = parseInt(m[3], 10);\n  const key = owner + '/' + repo + '#' + number;\n  if (seen.has(key)) { continue; }\n  seen.add(key);\n  const rawLabels = Array.isArray(g.labels) ? g.labels : [];\n  const labels = rawLabels.map(function (l) { return typeof l === 'string' ? l : (l && l.name) || ''; }).filter(function (l) { return l !== ''; });\n  out.push({ json: {\n    delivery_id: 'reconcile:' + key,\n    repository_owner: owner,\n    repository_name: repo,\n    issue_number: number,\n    title: g.title == null ? '' : String(g.title),\n    body: g.body == null ? '' : String(g.body),\n    labels: labels,\n    author: (g.user && g.user.login) || '',\n    issue_url: url\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "dd703f88-d287-4ad6-a571-02640d5825d1",
      "name": "POST To Triage Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/github-issue-triage",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
