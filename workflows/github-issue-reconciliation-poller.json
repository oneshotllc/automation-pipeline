    },
    {
      "id": "3c03e03a-5c53-49a0-ab2c-2183bc6d7d63",
      "name": "List Open Issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "authentication": "githubAppApi",
        "resource": "repository",
        "operation": "getIssues",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "oneshotllc"
        },
        "repository": {
          "__rl": true,
