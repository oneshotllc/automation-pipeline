{
  "id": "JphUDyra2G4u2XFd",
  "name": "Provision Monitor",
  "description": "Polls the configured repository's Actions runs and the configured site's reachability. Config-driven; no model call.",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "66808873-e6aa-4a85-a9ab-c8687e7ca6c4",
      "name": "Poll Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        96
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.monitor.actions_repo }}/actions/runs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "15"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "8a98a486-371c-48d5-9528-eb9745c57833",
      "name": "Fetch Workflow Runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "credentials": {
        "githubAppApi": {
          "id": "ghAppOneshotPr01",
          "name": "GitHub App - oneshot-pr-bot"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const runs = $input.first().json.workflow_runs || [];\nconst rows = runs.map(r => ({\n  run_id: r.id,\n  workflow: r.name,\n  status: r.status,\n  conclusion: r.conclusion || 'in_progress',\n  event: r.event,\n  actor: (r.actor && r.actor.login) || 'unknown',\n  branch: r.head_branch,\n  started_at: r.run_started_at,\n  logs_url: r.html_url,\n  running: r.status !== 'completed',\n  failed: r.conclusion === 'failure' || r.conclusion === 'startup_failure'\n}));\nconst running = rows.filter(r => r.running);\nconst failed = rows.filter(r => r.failed);\nreturn [{ json: {\n  checked_at: new Date().toISOString(),\n  total: rows.length,\n  running_count: running.length,\n  failed_count: failed.length,\n  headline: running.length > 0 ? ('RUNNING: ' + running[0].workflow) : (failed.length > 0 ? ('FAILED: ' + failed[0].workflow) : 'idle - all green'),\n  runs: rows\n} }];"
      },
      "id": "9568b0ad-d13b-4081-8830-b0ed0a7ca318",
      "name": "Build Action Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "34902d47-b7e4-47da-8ff4-b1f7c84cf54a",
      "name": "Combine Dashboard",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.monitor.site_url }}",
        "options": {
          "redirect": {
            "redirect": {}
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "id": "e3e64334-7e55-44e6-a07a-d63657a0f075",
      "name": "Check Site Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        192
      ],
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst code = r.statusCode || 0;\nconst body = typeof r.body === 'string' ? r.body : '';\nreturn [{ json: {\n  site_url: $('Config').first().json.monitor.site_url,\n  http_status: code,\n  reachable: code >= 200 && code < 400,\n  looks_like_wordpress: body.includes('wp-content') || body.includes('wp-includes'),\n  checked_at: new Date().toISOString(),\n  note: 'Checked from the pipeline host, a reachability signal only.'\n} }];"
      },
      "id": "c4ad4490-cbd7-4d63-a05f-88f6b87c95d8",
      "name": "Summarize Site Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "content": "## Provision Monitor\n\nMechanics only; targets come from the config key (`monitor.actions_repo`, `monitor.site_url`). Polls the configured repo's Actions runs and checks the configured site's reachability so provisioning activity and logs are visible here.",
        "height": 200,
        "width": 300,
        "color": 4
      },
      "id": "b80c0b44-6f9b-41b4-b198-ec6663339274",
      "name": "Sticky Note 3b43df5e",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -288,
        -224
      ]
    },
    {
      "id": "e1076083-ab8f-41cf-af83-fb1cab1197d2",
      "name": "Load Config",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        80,
        96
      ],
      "parameters": {
        "operation": "get",
        "propertyName": "cfg",
        "key": "cfg:pipeline",
        "keyType": "string",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redisLocalQueue1",
          "name": "Redis (local triage queue)"
        }
      }
    },
    {
      "id": "7722e4cc-e90f-4a4c-a7c2-818c242b2c90",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        150,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: JSON.parse($input.first().json.cfg) }];"
      }
    }
  ],
  "connections": {
    "Fetch Workflow Runs": {
      "main": [
        [
          {
            "node": "Build Action Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Action Log": {
      "main": [
        [
          {
            "node": "Combine Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Site Health": {
      "main": [
        [
          {
            "node": "Summarize Site Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Site Health": {
      "main": [
        [
          {
            "node": "Combine Dashboard",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Poll Every Minute": {
      "main": [
        [
          {
            "node": "Load Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Config": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch Workflow Runs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Site Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "binaryMode": "separate"
  },
  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "nodeGroups": []
}