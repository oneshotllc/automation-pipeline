      {
        "id": "0d1f3b74-d097-4e43-acfa-723dfe1f7b85",
        "name": "Build Payload",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2640,
          -140
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "// Same table lookup as Route To Stream; the build queue is per stream too.\nconst src = $('Pop Intake Item').item.json.item;\nconst raw = $('Load Routing Table').first().json.content || '';\nconst table = JSON.parse(Buffer.from(String(raw).replace(/\\n/g, ''), 'base64').toString('utf8'));\nconst full = `${src.repository_owner}/${src.repository_name}`;\nconst globToRe = g => new RegExp('^' + String(g).split('*').map(s => s.replace(/[.+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*') + '$');\nlet stream = null;\nfor (const r of (table.rules || [])) { if (r && r.repo && globToRe(r.repo).test(full)) { stream = r.stream; break; } }\nif (!stream) stream = table.default || null;\nif (!stream) throw new Error(`sorter: no stream for ${full}`);\nconst item = Object.assign({}, src, { stream, stage: 'build', approved_at: new Date().toISOString() });\nreturn { json: { stream, key: `${full}#${src.issue_number}`, payload: JSON.stringify(item) } };"
        }
      },
