      "id": "b1a41a26-4dd8-4a76-a00d-b5915842b63c",
      "name": "Classify Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Feedback items skip triage and go straight to the build queue; pull requests authored by a configured bot on a pipeline branch are never triaged.\nconst cfg = $('Config').first().json;\nconst it = $json.item || {};\nconst isFeedback = it.stage === 'feedback';\nconst isPR = /\\/pull\\/\\d+/.test(String(it.issue_url || ''));\nconst botPR = isPR && (cfg.bots || []).includes(String(it.author || ''));\nconst key = `${it.repository_owner}/${it.repository_name}#${it.issue_number}`;\nreturn { json: { item: it, key, isFeedback, drop: botPR && !isFeedback, feedback_claim: isFeedback ? `${cfg.feedback.claim_prefix}${key}@${it.feedback_id || ''}` : '' } };"
      }
    },
