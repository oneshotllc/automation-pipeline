    {
      "id": "6d6ecf18-4114-4326-abe4-8406a79bd61d",
      "name": "Route To Stream",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Table lookup only. Streams and rules come from config.\nconst cfg = $('Config').first().json;\nconst src = $('Pop Intake Item').item.json.item;\nconst full = `${src.repository_owner}/${src.repository_name}`;\nconst globToRe = g => new RegExp('^' + String(g).split('*').map(s => s.replace(/[.+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*') + '$');\nlet stream = null;\nfor (const r of ((cfg.streams && cfg.streams.rules) || [])) { if (r && r.repo && globToRe(r.repo).test(full)) { stream = r.stream; break; } }\nif (!stream) stream = (cfg.streams && cfg.streams.default) || null;\nif (!stream) throw new Error(`sorter: no stream for ${full} and no default stream in config`);\nconst item = Object.assign({}, src, { stream });\nreturn { json: { stream, list: cfg.queues.stream_prefix + stream, key: `${full}#${src.issue_number}`, payload: JSON.stringify(item) } };"
      }
    },
