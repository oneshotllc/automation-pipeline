    {
      "id": "804b1560-4c18-46a7-9665-3c1c2a4dfef6",
      "name": "Blocker Refs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Head-of-chain rule. Primary: the dependencies API (blocked_by). Fallback: body lines '<blocked_by_line> #N'.\nconst cfg = $('Config').first().json;\nconst src = $('Pop Intake Item').item.json.item;\nconst resp = $input.first().json;\nconst status = Number(resp.statusCode || 0);\nconst body = resp.body;\nif (status >= 200 && status < 300 && Array.isArray(body)) {\n  const open = body.filter(b => b && b.state === 'open').map(b => b.number);\n  return [{ json: { source: 'api', open_blockers: open, refs: [], head: open.length === 0 } }];\n}\nconst marker = String((cfg.chain && cfg.chain.blocked_by_line) || 'Blocked by:');\nconst re = new RegExp(marker.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\s*#(\\\\d+)', 'gi');\nconst refs = []; let m; while ((m = re.exec(String(src.body || '')))) refs.push(Number(m[1]));\nreturn [{ json: { source: 'body', open_blockers: [], refs, head: refs.length === 0 } }];"
      }
    },
