        }
      }
    },
    {
      "id": "253e7fc5-b914-4c7b-aacf-fad12bf82f83",
      "name": "Sorter Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -160
      ],
      "parameters": {
        "color": 4,
        "width": 1700,
        "height": 300,
        "content": "## Queue Sorter\n\nMechanics only; names come from the config key. Every run: load config, then loop-pop the intake queue (max 500 per run).\n\nTriage path (not yet seen): route repo to stream from `streams.rules` / `streams.default`, push to `<stream_prefix><stream>`.\n\nApproval path (already seen): an issue (not a PR) without the hold label whose spec marker exists is claimed once (`<build_prefix><key>` INCR) and pushed to `<build_prefix stream queue>`; the consumer of that queue builds it.\n\nNo model call. Table lookups and key checks only."
      }
    },
    {
      "id": "b080a0d1-bff7-43ca-bc0b-0d4139dd2079",
      "name": "Approval Eligibility",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -140
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// A seen issue with no hold label may proceed to the build queue.\nconst cfg = $('Config').first().json;\nconst src = $('Pop Intake Item').item.json.item;\nconst labels = (src.labels || []).map(l => typeof l === 'string' ? l : (l && l.name) || '');\nconst isPR = /\\/pull\\/\\d+/.test(String(src.issue_url || ''));\nconst held = labels.includes(cfg.labels.hold);\nconst key = `${src.repository_owner}/${src.repository_name}#${src.issue_number}`;\nreturn { json: { key, eligible: !held && !isPR, held, isPR } };"
      }
    },
