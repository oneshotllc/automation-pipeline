    {
      "id": "83b59b00-5a0f-489c-a6c4-042a8e7c35fb",
      "name": "TDD BDD Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1328,
        240
      ],
      "parameters": {
        "jsonSchemaExample": "{\"problem_statement\":\"Concise source-grounded statement\",\"assumptions\":[\"Explicit assumption\"],\"gherkin_scenarios\":[\"Given a precondition\\nWhen an action occurs\\nThen an observable result follows\"],\"tdd_test_matrix\":[\"Unit | behavior under test | expected result\"],\"execution_instructions\":[\"Use RED-GREEN-REFACTOR, then independent QA verification.\"],\"relevant_context\":[\"Source-grounded context\"],\"proposed_scope\":[\"One implementation scope item\"],\"acceptance_criteria\":[\"One observable acceptance criterion\"],\"technical_notes\":[\"Implementation constraint\"],\"questions_or_assumptions\":[\"Open question or explicit uncertainty\"],\"suggested_labels\":[\"bug\"]}"
      }
    },
    {
      "id": "bddc2db3-161b-4244-b4a9-1f3a75a0b2fb",
      "name": "Render Comment Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const spec = $json.output ?? $json;\nconst src = $(\"Pop Queue Item\").item.json.item;\nconst NL = String.fromCharCode(10);\nconst list = (title, arr) => {\n  const rows = (arr || []).map(v => \"- \" + String(v).split(NL).join(NL + \"  \"));\n  return rows.length ? (\"### \" + title + NL + rows.join(NL) + NL + NL) : \"\";\n};\nconst fence = String.fromCharCode(96,96,96);\nconst gherkin = (spec.gherkin_scenarios || []).map(s => fence + \"gherkin\" + NL + s + NL + fence).join(NL + NL);\nconst parts = [];\nparts.push(\"## TDD/BDD Execution Spec\" + NL + NL);\nparts.push(\"**Problem**\" + NL + NL + (spec.problem_statement || \"\") + NL + NL);\nif (gherkin) { parts.push(\"### Gherkin Scenarios\" + NL + NL + gherkin + NL + NL); }\nparts.push(list(\"TDD Test Matrix\", spec.tdd_test_matrix));\nparts.push(list(\"Execution Instructions\", spec.execution_instructions));\nparts.push(list(\"Acceptance Criteria\", spec.acceptance_criteria));\nparts.push(list(\"Proposed Scope\", spec.proposed_scope));\nparts.push(list(\"Technical Notes\", spec.technical_notes));\nparts.push(list(\"Assumptions\", spec.assumptions));\nparts.push(list(\"Questions / Uncertainty\", spec.questions_or_assumptions));\nparts.push(NL + \"<sub>Generated automatically for \" + src.delivery_id + \"</sub>\");\nreturn { json: { comment_body: parts.join(\"\"), repository_owner: src.repository_owner, repository_name: src.repository_name, issue_number: src.issue_number } };"
      }
    },
