    {
      "id": "d8a67214-bf16-46aa-8b61-d593dba6dfa1",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        150,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: JSON.parse($input.first().json.cfg) }];"
      }
    },
    {
      "id": "f949f905-0bb4-4821-9820-9af3ed69c756",
      "name": "Stream Queues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        190,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per configured stream: this consumer serves every stream, one pop each per tick.\nconst cfg = $input.first().json;\nconst names = new Set([cfg.streams.default, ...((cfg.streams.rules || []).map(r => r.stream))].filter(Boolean));\nreturn [...names].map(s => ({ json: { stream: s, list: cfg.queues.stream_prefix + s } }));"
      }
    },
