    {
      "id": "35377fbc-a2ab-4c1d-b632-60ccaecfce36",
      "name": "Sticky Note 678dc2a5",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        174,
        -50
      ],
      "parameters": {
        "content": "## Stream Consumer\n\nMechanics only; names come from the config key. Each tick: load config, one pop per configured stream queue. Items without `stream` are rejected with an error.\n\nINCR on `<seen_prefix><owner>/<repo>#<n>` is the atomic first-winner claim. After the spec comment is posted, the hold label from config is applied and `<spec_prefix><key>` is set. Removing the hold label on the issue is the approval; the sorter's approval path then releases the item to the build queue exactly once.\n\nA failed comment post is an error execution.",
        "color": 4,
        "width": 972,
        "height": 312
      }
    },
    {
      "id": "42d3fbaf-500f-4609-a8db-830ece5d96cf",
      "name": "Has Stream",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        0
      ],
