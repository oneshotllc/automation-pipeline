{
  "id": "8ukVVloMcWl0jMkz",
  "name": "Stream Consumer",
  "description": "Pops each configured stream queue, claims the item, generates the specification comment through the model, posts it, applies the hold label and records the spec marker. Config-driven.",
  "active": true,
  "nodes": [
